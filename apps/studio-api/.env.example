# Agent Studio API
STUDIO_API_PORT=8790

# MySQL (required) — prefer Docker
#   docker compose -f deploy/mysql/docker-compose.yml up -d
#   mysql -h 127.0.0.1 -P 3316 -u root -p123456 < apps/studio-api/sql/init.sql
STUDIO_MYSQL_HOST=127.0.0.1
STUDIO_MYSQL_PORT=3316
STUDIO_MYSQL_USER=root
STUDIO_MYSQL_PASSWORD=123456
STUDIO_MYSQL_DATABASE=agent_studio
# STUDIO_MYSQL_LOGGING=true
# STUDIO_MYSQL_SYNC=true   # optional TypeORM auto-sync; prefer init.sql

# JWT + first admin (created when users table is empty)
STUDIO_JWT_SECRET=dev-studio-jwt-secret-change-me
STUDIO_ADMIN_USER=admin
STUDIO_ADMIN_PASSWORD=admin123

# Live file dirs (still on disk; defaults under apps/studio-api/data/)
# STUDIO_CHAT_DIR=           # work-order manager chats
# STUDIO_TEAM_SETTINGS_DIR=  # per-team language etc.
# STUDIO_TEAM_SECRETS_DIR=   # per-team Bridge/Git overlays (0600 yaml)
# STUDIO_CONFIG=             # data/studio-config.yaml
# STUDIO_REPOS_DIR=          # optional UI debug clone root (default ~/AgentStudio); work-order workspace is on Bridge

# One-shot YAML → MySQL migrate only (optional; not runtime storage)
# STUDIO_DATA_DIR=           # old digital humans YAML
# STUDIO_PIPELINE_DIR=       # old pipelines YAML
# STUDIO_BRIDGE_DIR=         # old bridges YAML
# STUDIO_PROJECT_DIR=        # old projects YAML
# STUDIO_WORKORDER_DIR=      # old work orders YAML
# STUDIO_RUN_LOG_DIR=        # old run-log directories

# STUDIO_BRIDGE_TOKEN=       # shared secret for executor registration + Bridge HTTP
# BRIDGE_HTTP_TOKEN=         # optional alias; Studio → Bridge Authorization: Bearer …

# Agent output language: zh | en (UI → 设置 also writes data/studio-config.yaml)
# STUDIO_LANGUAGE=zh

# Default Bridge URL for Studio orchestrator (UI 设置 / team-secrets 可覆盖)
# STUDIO_BRIDGE_BASE_URL=http://127.0.0.1:8787
# STUDIO_AGENTS_MD_PATH=auto

# Git clone via SSH (same bot key as Bridge; auto-on when key file exists)
# STUDIO_GIT_PREFER_SSH=true
# STUDIO_GIT_SSH_KEY=~/.ssh/agent_studio_bot
# STUDIO_GIT_SSH_PORT=22
# STUDIO_GIT_SSH_USER=git
# (aliases BRIDGE_GIT_* also work)
