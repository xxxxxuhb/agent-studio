# Agent Studio API
STUDIO_API_PORT=8790

# MySQL (required) — prefer Docker
#   docker compose -f deploy/mysql/docker-compose.yml up -d
#   mysql -h 127.0.0.1 -P 3316 -u root -p123456 < apps/studio-api/sql/init.sql
STUDIO_MYSQL_HOST=127.0.0.1
STUDIO_MYSQL_PORT=3316
STUDIO_MYSQL_USER=root
STUDIO_MYSQL_PASSWORD=123456
STUDIO_MYSQL_DATABASE=agent_studio
# STUDIO_MYSQL_LOGGING=true
# STUDIO_MYSQL_SYNC=true   # optional TypeORM auto-sync; prefer init.sql

# JWT + first admin (created when users table is empty)
STUDIO_JWT_SECRET=dev-studio-jwt-secret-change-me
STUDIO_ADMIN_USER=admin
STUDIO_ADMIN_PASSWORD=admin123

# Optional data dirs (defaults under apps/studio-api/data/)
# STUDIO_DATA_DIR=
# STUDIO_PIPELINE_DIR=
# STUDIO_WORKORDER_DIR=
# STUDIO_PROJECT_DIR=          # YAML projects dir used only for one-time MySQL migration
# STUDIO_REPOS_DIR=          # default: ~/AgentStudio (mac/linux) or C:\.agent-studio (windows)
# STUDIO_RUN_LOG_DIR=        # per-run logs (JSONL)
# STUDIO_BRIDGE_TOKEN=       # shared secret for executor registration + Bridge HTTP
# BRIDGE_HTTP_TOKEN=         # optional alias; Studio/Dify send Authorization: Bearer …

# Agent output language: zh | en (UI → 设置 also writes data/studio-config.yaml)
# STUDIO_LANGUAGE=zh

# Dify (can also be set in UI → 设置)
# Prefer putting api_key / console_token here; UI secrets go to data/dify-secrets.yaml (0600)
# DIFY_ENABLED=true
# DIFY_API_BASE=http://localhost/v1
# DIFY_API_KEY=app-xxxxxxxx
# DIFY_BRIDGE_BASE_URL=http://host.docker.internal:8787
# DIFY_AGENTS_MD_PATH=auto
# DIFY_RESPONSE_MODE=streaming
# DIFY_CONSOLE_BASE=http://localhost/console/api
# DIFY_CONSOLE_EMAIL=admin@example.com
# DIFY_CONSOLE_TOKEN=
# DIFY_CONSOLE_CSRF=
# STUDIO_DIFY_SECRETS=       # default: data/dify-secrets.yaml (split from dify-config.yaml)

# Git clone via SSH (same bot key as Bridge; auto-on when key file exists)
# STUDIO_GIT_PREFER_SSH=true
# STUDIO_GIT_SSH_KEY=~/.ssh/agent_studio_bot
# STUDIO_GIT_SSH_PORT=2224
# STUDIO_GIT_SSH_USER=git
# (aliases BRIDGE_GIT_* also work)
