{
  "name": "@agent-studio/orchestrator",
  "version": "0.1.0",
  "private": true,
  "description": "Studio self-managed pipeline runner over Bridge (no Dify)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/stage-map.test.js dist/runner.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@agent-studio/agent-schema": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2"
  }
}
