BRIDGE_PORT=8787
BRIDGE_HOST=0.0.0.0
# BRIDGE_NAME=my-mac
# BRIDGE_PUBLIC_URL=http://192.168.1.8:8787
# How this process links to Studio: cli (default) | desktop (bridge-desktop sets this)
# BRIDGE_LINK_TYPE=cli

# Workspace root on THIS machine (Studio no longer clones for work-order runs)
# BRIDGE_REPOS_DIR=~/AgentStudio
# Run metadata (runs.json); defaults to ./data/bridge-runs
# BRIDGE_DATA_DIR=./data/bridge-runs

# Disk GC (safe defaults: dry-run; never deletes whole repo clones)
# CLI: npx agent-studio-bridge gc          # dry-run
# CLI: npx agent-studio-bridge gc --apply  # delete stale prompts + terminal docs/runs
# HTTP: POST /admin/gc  { "apply": false }  (requires Bridge HTTP auth)
# BRIDGE_GC_DRY_RUN=true
# BRIDGE_GC_PROMPT_HOURS=24
# BRIDGE_GC_ARTIFACT_DAYS=14
# BRIDGE_GC_RUNS_JSON_DAYS=30

# Agent type: auto | cursor | openai | trae | qoder
AGENT_DRIVER=auto

# Cursor: set key OR run bridge with --login (browser SDK login)
# Get a key: https://cursor.com/dashboard/api
# CURSOR_API_KEY=cursor_xxx
# CURSOR_MODEL=composer-2.5

# Trae (TraeCode CLI): install traecli on PATH, then token or interactive /login
# Docs: https://docs.trae.cn/cli_login-token
# TRAECLI_PERSONAL_ACCESS_TOKEN=trae-lt-xxx
# TRAECLI_PATH=/usr/local/bin/traecli
# TRAECLI_HOST=https://your-enterprise-trae-host
# TRAE_YOLO=0

# Qoder: PAT (servers) or local qodercli login (desktops)
# Docs: https://qoder.com/account/integrations
# After monorepo `npm install` (SDK + worker runtime):
# QODER_PERSONAL_ACCESS_TOKEN=pt-xxx
# QODER_AUTH=qodercli
# QODERCLI_PATH=/usr/local/bin/qodercli
# QODER_MODEL=
# STUDIO_URL=http://127.0.0.1:8790
# STUDIO_BRIDGE_TOKEN=dev-bridge-token
# Same value used for Bridge HTTP auth (Studio → Bridge). Alias: BRIDGE_HTTP_TOKEN
# BRIDGE_HTTP_TOKEN=dev-bridge-token

# --- Git bot identity (commit author) + SSH push ---
# Create a GitLab bot user (not root), add SSH key + PAT with api/write_repository.
# BRIDGE_GIT_AUTHOR_NAME=agent-studio-bot
# BRIDGE_GIT_AUTHOR_EMAIL=bot@agent-studio.local
# BRIDGE_GIT_FORCE_AUTHOR=true
#
# Prefer SSH remotes (auto-on when BRIDGE_GIT_SSH_KEY exists):
# BRIDGE_GIT_PREFER_SSH=true
# BRIDGE_GIT_SSH_KEY=~/.ssh/agent_studio_bot
# BRIDGE_GIT_SSH_PORT=22
# BRIDGE_GIT_SSH_USER=git
#
# After review pass: open merge PR/MR via forge API (same bot PAT recommended):
# BRIDGE_GIT_CREATE_PR=true
# GITLAB_TOKEN=glpat-xxx
# BRIDGE_GITLAB_API=https://gitlab.example.com/api/v4
# BRIDGE_GITLAB_WEB=https://gitlab.example.com
#
# GitHub:
# GITHUB_TOKEN=ghp_xxx
